rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Adresses Google autorisées à lire les résultats (page resultats.html).
    function isOrganizer() {
      return request.auth != null
        && request.auth.token.email in ['ddigloria@emasphere.com'];
    }
ce qu
    function isCode(value) {
      return value is string && value.size() > 2 && value.size() < 120 && value.matches('^[ab]:.+$');
    }

    function isEmail(value) {
      return value is string && value.size() < 200 && value.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$');
    }

    match /matches/{matchId} {
      // Fiche du match écrite par la page de vote : composition des équipes, sans rien de sensible.
      allow read: if isOrganizer();
      allow create, update: if matchId.matches('^[A-Za-z0-9_-]{3,80}$')
        && request.resource.data.keys().hasOnly(['teamA', 'teamB', 'playersA', 'playersB', 'updatedAt'])
        && request.resource.data.playersA is list && request.resource.data.playersA.size() <= 12
        && request.resource.data.playersB is list && request.resource.data.playersB.size() <= 12;
      allow delete: if false;

      match /ballots/{ballotId} {
        // Un bulletin par adresse e-mail (l'adresse est l'identifiant du document) : trois choix distincts,
        // empreinte d'appareil, horodatage serveur. Jamais modifiable, donc pas de second vote.
        allow read: if isOrganizer();
        allow create: if request.resource.data.keys().hasOnly(['email', 'first', 'second', 'third', 'device', 'createdAt'])
          && isEmail(request.resource.data.email)
          && ballotId == request.resource.data.email
          && request.resource.data.device is string && request.resource.data.device.size() < 80
          && isCode(request.resource.data.first)
          && isCode(request.resource.data.second)
          && isCode(request.resource.data.third)
          && request.resource.data.first != request.resource.data.second
          && request.resource.data.first != request.resource.data.third
          && request.resource.data.second != request.resource.data.third
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
